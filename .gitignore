.vscode/browse.vc.db*

# Compiled object files and binaries
*.o
*.elf
*.bin
*.hex
*.map
*.su
*.d

# Python cache (plotting scripts)
__pycache__/
*.pyc

# Editor temporaries
*~
*.swp
*.swo
.DS_Store

