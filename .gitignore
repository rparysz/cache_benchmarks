# Copilot session state
.copilot/

# CMake build output
build/

# compile_commands.json — auto-generated by CMake post-configure hook (see CMakeLists.txt)
compile_commands.json

# CubeMX backup and project metadata
*.ioc.bak
.mxproject

# clangd index cache
.cache/

# VS Code generated/local-only files (keep settings.json)
